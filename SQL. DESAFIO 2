-- consultas

select * from clients;
select * from vehicles;

-- quais mecanicos sao da equipe 1?
select mName, specialty from mechanics where idTeam = 1;

-- quais OS ainda estão abertas?
select * from serviceOrder where osStatus = 'Em execução' or osStatus = 'Aguardando autorização';

-- idade dos veiculos
select plate, model, year(curdate()) - vehicleYear as idade from vehicles order by idade desc;

-- quantos dias cada OS levou pra ficar pronta
select idOS, issueDate, deliveryDate, datediff(deliveryDate, issueDate) as dias
	from serviceOrder
    where osStatus = 'Concluída'
    order by dias;

 veiculos de cada cliente
select c.Fname, c.Lname, v.plate, v.model
	from clients c
    inner join vehicles v on c.idClient = v.idClient
    order by c.Fname;
valor da mão de obra de cada OS
select os.idOS, v.plate, sum(oss.quantity * s.laborValue) as valor_mao_de_obra
	from serviceOrder os
    inner join vehicles v on v.idVehicle = os.idVehicle
    inner join osServices oss on os.idOS = oss.idOS
    inner join services s on s.idService = oss.idService
    group by os.idOS, v.plate
    order by valor_mao_de_obra desc;
 valor das peças de cada OS
select osp.idOS, sum(osp.quantity * p.pValue) as valor_pecas
	from osParts osp
    inner join parts p on p.idPart = osp.idPart
    group by osp.idOS;

quantas OS cada equipe atendeu?
select t.teamName, count(os.idOS) as qtd_os
	from team t
    left join serviceOrder os on t.idTeam = os.idTeam
    group by t.teamName
    order by qtd_os desc;

clientes com mais de um veiculo
select c.Fname, c.Lname, count(*) as qtd_veiculos
	from clients c
    inner join vehicles v on c.idClient = v.idClient
    group by c.idClient, c.Fname, c.Lname
    having count(*) > 1;

 serviços que foram feitos mais de uma vez
select s.sDescription, count(*) as vezes
	from services s
    inner join osServices oss on s.idService = oss.idService
    group by s.sDescription
    having vezes > 1;

 mecanicos que trabalharam em cada OS
select os.idOS, v.plate, t.teamName, m.mName
	from serviceOrder os
    inner join vehicles v on v.idVehicle = os.idVehicle
    inner join team t on t.idTeam = os.idTeam
    inner join mechanics m on m.idTeam = t.idTeam
    order by os.idOS;
