-- banco de dados da oficina
-- drop database oficina;
create database oficina;
use oficina;

-- tabela cliente
create table clients(
	idClient int auto_increment primary key,
    Fname varchar(15) not null,
    Lname varchar(20),
    CPF char(11) not null,
    phone varchar(11),
    Address varchar(255),
    constraint unique_cpf_client unique (CPF)
);

-- tabela veículo
create table vehicles(
	idVehicle int auto_increment primary key,
    idClient int not null,
    plate char(7) not null,
    model varchar(30),
    brand varchar(20),
    vehicleYear int,
    constraint unique_plate unique (plate),
    constraint fk_vehicle_client foreign key (idClient) references clients(idClient)
);

-- tabela equipe
create table team(
	idTeam int auto_increment primary key,
    teamName varchar(30) not null
);

-- tabela mecânico
create table mechanics(
	idMechanic int auto_increment primary key,
    idTeam int,
    code char(5) not null,
    mName varchar(45) not null,
    Address varchar(255),
    specialty varchar(30),
    constraint unique_code_mechanic unique (code),
    constraint fk_mechanic_team foreign key (idTeam) references team(idTeam)
);

-- tabela ordem de serviço (OS)
create table serviceOrder(
	idOS int auto_increment primary key,
    idVehicle int not null,
    idTeam int not null,
    osType enum('Conserto','Revisão') not null,
    issueDate date not null,
    deliveryDate date,
    osStatus enum('Aguardando autorização','Autorizada','Em execução','Concluída','Cancelada') default 'Aguardando autorização',
    authorized bool default false,
    constraint fk_os_vehicle foreign key (idVehicle) references vehicles(idVehicle),
    constraint fk_os_team foreign key (idTeam) references team(idTeam)
);

-- tabela de serviços (valor da mão de obra)
create table services(
	idService int auto_increment primary key,
    sDescription varchar(45) not null,
    laborValue float not null
);

-- tabela peças
create table parts(
	idPart int auto_increment primary key,
    pName varchar(45) not null,
    pValue float not null
);

-- serviços de cada OS
create table osServices(
	idOS int,
    idService int,
    quantity int default 1,
    primary key (idOS, idService),
    constraint fk_osservices_os foreign key (idOS) references serviceOrder(idOS),
    constraint fk_osservices_service foreign key (idService) references services(idService)
);

-- peças de cada OS
create table osParts(
	idOS int,
    idPart int,
    quantity int default 1,
    primary key (idOS, idPart),
    constraint fk_osparts_os foreign key (idOS) references serviceOrder(idOS),
    constraint fk_osparts_part foreign key (idPart) references parts(idPart)
);

show tables;


