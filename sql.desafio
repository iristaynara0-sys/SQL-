consultas

todos os clientes cadastrados
select * from clients;
 quais produtos são da categoria eletrônico?
select Pname, price from product where category = 'Eletrônico';

quais produtos custam mais de 100 reais?
select Pname, category, price from product where price > 100 order by price desc;

nome completo dos clientes (atributo derivado)
select concat(Fname,' ',Lname) as Client_name, clientType from clients;

quantos pedidos foram feitos por cada cliente?
select c.idClient, concat(Fname,' ',Lname) as Client, count(o.idOrder) as Number_of_orders
	from clients c
    left join orders o on c.idClient = o.idOrderClient
    group by c.idClient, c.Fname, c.Lname
    order by Number_of_orders desc;

valor total de cada pedido, somando produtos e frete (atributo derivado)
select o.idOrder, concat(c.Fname,' ',c.Lname) as Client,
	sum(po.poQuantity * p.price) as products_value,
    ifnull(o.sendValue,0) as send_value,
    sum(po.poQuantity * p.price) + ifnull(o.sendValue,0) as total_value
	from orders o
    inner join clients c on c.idClient = o.idOrderClient
    inner join productOrder po on po.idPOorder = o.idOrder
    inner join product p on p.idProduct = po.idPOproduct
    group by o.idOrder, c.Fname, c.Lname, o.sendValue
    order by total_value desc;

-- algum vendedor também é fornecedor?
select s.SocialName as Seller, sp.SocialName as Supplier, s.CNPJ
	from seller s
    inner join supplier sp on s.CNPJ = sp.CNPJ;

-- relação de produtos, fornecedores e estoques
select p.Pname as Product, sp.SocialName as Supplier, ps.storageLocation, ps.quantity
	from product p
    inner join productSupplier psu on p.idProduct = psu.idPsProduct
    inner join supplier sp on sp.idSupplier = psu.idPsSupplier
    inner join storageLocation sl on p.idProduct = sl.idLproduct
    inner join productStorage ps on ps.idProdStorage = sl.idLstorage
    order by p.Pname;

relação de nomes dos fornecedores e nomes dos produtos
select sp.SocialName as Supplier, p.Pname as Product, psu.quantity
	from supplier sp
    inner join productSupplier psu on sp.idSupplier = psu.idPsSupplier
    inner join product p on p.idProduct = psu.idPsProduct
    order by sp.SocialName;

quais fornecedores fornecem mais de um produto?
select sp.SocialName, count(*) as Number_of_products
	from supplier sp
    inner join productSupplier psu on sp.idSupplier = psu.idPsSupplier
    group by sp.SocialName
    having count(*) > 1;

clientes que gastaram mais de 500 reais em pedidos
select concat(c.Fname,' ',c.Lname) as Client, sum(po.poQuantity * p.price) as Total_spent
	from clients c
    inner join orders o on c.idClient = o.idOrderClient
    inner join productOrder po on po.idPOorder = o.idOrder
    inner join product p on p.idProduct = po.idPOproduct
    group by c.idClient, c.Fname, c.Lname
    having Total_spent > 500
    order by Total_spent desc;

status da entrega de cada pedido
select o.idOrder, o.orderStatus, d.deliveryStatus, d.trackingCode
	from orders o
    left join delivery d on o.idOrder = d.idOrder;

 clientes com mais de uma forma de pagamento
select concat(c.Fname,' ',c.Lname) as Client, count(*) as Payment_methods
	from clients c
    inner join payments pay on c.idClient = pay.idClient
    group by c.idClient, c.Fname, c.Lname
    having count(*) > 1;
